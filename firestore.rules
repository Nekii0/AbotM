rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace with the Google account emails allowed to add, edit and remove resources.
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }

    function validResource() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'link', 'page', 'createdAt'])
        && d.page in ['volunteer', 'wellness', 'education', 'donate', 'request-help', 'community-needs']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.description is string && d.description.size() > 0 && d.description.size() <= 140
        && d.link is string && d.link.size() <= 300;
    }

    match /resources/{id} {
      allow read: if true;
      allow create: if isAdmin() && validResource()
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validResource()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.page == resource.data.page;
      allow delete: if isAdmin();
    }
  }
}
