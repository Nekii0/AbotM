rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace with the Google account emails allowed to add, edit and remove resources.
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }

    function validResource() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'link', 'page', 'createdAt'])
        && d.page in ['volunteer', 'wellness', 'education', 'donate', 'request-help', 'community-needs', 'announcements', 'events', 'needs', 'jobs', 'openings']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.description is string && d.description.size() > 0 && d.description.size() <= 140
        && d.link is string && d.link.size() <= 300;
    }

    match /resources/{id} {
      allow read: if true;
      allow create: if isAdmin() && validResource()
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validResource()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.page == resource.data.page;
      allow delete: if isAdmin();
    }

    // Lets the website check whether the signed-in account is an admin. Nothing is stored here.
    match /admin-check/{id} {
      allow read: if isAdmin();
    }

    // Admin edits to built-in page text (one document per edited line).
    match /content/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'page', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.page is string && request.resource.data.page.size() <= 40;
      allow delete: if isAdmin();
    }

    // Volunteer sign-ups from volunteer.html: anyone can send one, only admins can read or remove them.
    match /volunteers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'barangay', 'contact', 'availability', 'interests', 'note', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.barangay is string && request.resource.data.barangay.size() > 0 && request.resource.data.barangay.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 100
        && request.resource.data.availability in ['Weekdays', 'Weekends', 'Evenings', 'Anytime']
        && request.resource.data.interests is list && request.resource.data.interests.size() > 0 && request.resource.data.interests.size() <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
